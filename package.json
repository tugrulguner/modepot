{
  "name": "modepot",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "render:identity": "node scripts/render-identity.mjs",
    "check:identity": "node scripts/render-identity.mjs --check",
    "test:identity": "node --test scripts/identity-parity.test.mjs",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/verify-discovery.mjs && node scripts/verify-mechanisms.mjs && node scripts/verify-identity-assets.mjs",
    "test:privacy": "node --test src/lib/privacy-sanitizer.test.mjs",
    "test:privacy-sdk": "playwright test tests/privacy-sdk.spec.mjs --config=playwright.analytics.config.mjs",
    "test:project-sync": "node scripts/project-sync.test.mjs && node --test scripts/source-snapshot*.test.mjs",
    "preview": "astro preview",
    "test:analytics": "playwright test tests/analytics.spec.mjs --config=playwright.analytics.config.mjs",
    "test:layout": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.142.0"
  }
}
