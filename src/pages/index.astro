---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

const products = [
  {
    index: '01',
    mode: 'execution',
    name: 'dexpot',
    prefix: 'dex',
    image: '/products/dexpot.webp',
    alt: 'Dexpot cosmic potion artwork surrounded by Python API code and execution symbols',
    eyebrow: 'Synchronous Python API framework',
    statement: 'Plain handlers. Adaptive execution.',
    description:
      'Dexpot compiles routes once, validates JSON with msgspec, and adapts concurrency to standard GIL or free-threaded Python—without asking application code to become async.',
    href: 'https://github.com/tugrulguner/dexpot',
    site: 'dexpot.modepot.io',
    accent: 'cyan',
  },
  {
    index: '02',
    mode: 'interface',
    name: 'intpot',
    prefix: 'int',
    image: '/products/intpot.webp',
    alt: 'Intpot cosmic potion artwork connecting code, API endpoints, and interfaces',
    eyebrow: 'One definition, three interfaces',
    statement: 'Define once. Serve in every direction.',
    description:
      'Intpot turns typed Python tools into Typer CLIs, FastAPI apps, or FastMCP servers—and can inspect an existing app and convert it into either of the others.',
    href: 'https://github.com/tugrulguner/intpot',
    site: 'intpot.modepot.io',
    accent: 'gold',
  },
  {
    index: '03',
    mode: 'decision',
    name: 'summonpot',
    prefix: 'summon',
    image: '/products/summonpot.webp',
    alt: 'Summonpot cosmic potion artwork with bounded capabilities and a small coding agent',
    eyebrow: 'Contract-first agent-owned endpoints',
    statement: 'Declare the contract. Bound the authority.',
    description:
      'Summonpot combines typed API contracts, deterministic application operations, and explicitly bounded agent-owned decisions behind one executable endpoint declaration.',
    href: 'https://github.com/tugrulguner/summonpot',
    site: 'summonpot.modepot.io',
    accent: 'violet',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#070a12" />
    <meta
      name="description"
      content="ModePot is a family of focused Python tools: Dexpot, Intpot, and Summonpot."
    />
    <meta property="og:title" content="ModePot — tools for the mode you're in" />
    <meta
      property="og:description"
      content="Focused Python frameworks for execution, interfaces, and bounded agent-owned decisions."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://modepot.io" />
    <meta property="og:image" content="https://modepot.io/modepot-og.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ModePot — three focused modes held in one vessel" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://modepot.io" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ModePot — tools for the mode you're in</title>
  </head>
  <body>
    <a class="skip-link" href="#family">Skip to the family</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="ModePot home">
        <img src="/modepot-mark.svg" alt="" width="38" height="38" />
        <span>mode<strong>pot</strong></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#family">The family</a>
        <a href="https://github.com/tugrulguner" rel="me">GitHub</a>
        <a class="nav-signal" href="https://discord.gg/u3AANZr6RG">Discord</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="coordinate">MODE / 00 — THE SOURCE</p>
          <h1 id="hero-title"><span>mode</span><strong>pot</strong></h1>
          <p class="hero-line">Tools for the mode you’re in.</p>
          <p class="hero-description">
            A family of focused Python frameworks for execution, interfaces, and
            bounded agent-owned decisions.
          </p>
          <a class="text-link" href="#family">
            Open the cabinet
            <span aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="hero-object" aria-label="The ModePot family mark: three distinct modes held in one vessel">
          <span class="orbit orbit-one"></span>
          <span class="orbit orbit-two"></span>
          <img src="/modepot-mark.svg" alt="" width="420" height="420" />
          <p class="mode-label label-execution"><i></i> execution</p>
          <p class="mode-label label-interface"><i></i> interface</p>
          <p class="mode-label label-decision"><i></i> decision</p>
          <span class="object-note">THREE MODES<br />ONE FAMILY</span>
        </div>

        <p class="hero-aside" aria-hidden="true">PYTHON / OPEN SOURCE / 2026</p>
      </section>

      <section class="family-intro" id="family" aria-labelledby="family-title">
        <p class="coordinate">MODE / 01—03</p>
        <div>
          <h2 id="family-title">One family.<br /><em>Different jobs.</em></h2>
          <p>
            Each project owns one hard problem instead of becoming an everything-framework.
            Pick the mode that matches the work.
          </p>
        </div>
      </section>

      <div class="product-ledger">
        {
          products.map((product) => (
            <article class={`product product-${product.accent}`} id={product.name}>
              <div class="product-index" aria-hidden="true">
                <span>{product.index}</span>
                <span>{product.mode}</span>
              </div>

              <figure class="product-art">
                <img src={product.image} alt={product.alt} loading="lazy" width="1200" height="900" />
                <figcaption>{product.site}</figcaption>
              </figure>

              <div class="product-copy">
                <p class="product-eyebrow">{product.eyebrow}</p>
                <h3><span>{product.prefix}</span><strong>pot</strong></h3>
                <p class="product-statement">{product.statement}</p>
                <p class="product-description">{product.description}</p>
                <div class="product-actions">
                  <a class="product-link" href={product.href}>
                    View on GitHub <span aria-hidden="true">↗</span>
                  </a>
                  <span class="future-home">Future home / {product.site}</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <section class="family-rule" aria-labelledby="rule-title">
        <div class="rule-mark">
          <img src="/modepot-mark.svg" alt="" width="112" height="112" loading="lazy" />
        </div>
        <p class="coordinate">THE FAMILY RULE</p>
        <h2 id="rule-title">
          Not one platform.<br />A set of <em>precise instruments.</em>
        </h2>
        <p>
          ModePot projects stay small enough to understand, specific enough to matter,
          and open enough to shape in public.
        </p>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="#top" aria-label="Back to top">
        <img src="/modepot-mark.svg" alt="" width="32" height="32" loading="lazy" />
        <span>mode<strong>pot</strong></span>
      </a>
      <p>Focused tools, built in public.</p>
      <div>
        <a href="https://github.com/tugrulguner">GitHub</a>
        <a href="https://discord.gg/u3AANZr6RG">Discord</a>
      </div>
    </footer>
  </body>
</html>
