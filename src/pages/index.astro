---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

const products = [
  {
    index: '01',
    mode: 'execution',
    name: 'dexpot',
    prefix: 'dex',
    image: '/products/dexpot.webp',
    alt: 'Dexpot artwork showing a potion vessel with Python API code and execution symbols',
    category: 'Synchronous Python API framework',
    statement: 'Plain handlers. Adaptive execution.',
    choice: 'Build a synchronous Python HTTP API that adapts to GIL and free-threaded CPython.',
    description:
      'Dexpot compiles routes once, validates JSON with msgspec, and adapts concurrency to standard GIL or free-threaded Python—without asking application code to become async.',
    href: 'https://github.com/tugrulguner/dexpot',
    accent: 'cyan',
  },
  {
    index: '02',
    mode: 'interface',
    name: 'intpot',
    prefix: 'int',
    image: '/products/intpot.webp',
    alt: 'Intpot artwork showing a potion vessel connecting code, API endpoints, and interfaces',
    category: 'One definition, three interfaces',
    statement: 'Define once. Serve in every direction.',
    choice: 'Serve typed Python tools as a CLI, HTTP API, or MCP server—or convert between them.',
    description:
      'Intpot turns typed Python tools into Typer CLIs, FastAPI apps, or FastMCP servers—and can inspect an existing app and convert it into either of the others.',
    href: 'https://github.com/tugrulguner/intpot',
    accent: 'gold',
  },
  {
    index: '03',
    mode: 'decision',
    name: 'summonpot',
    prefix: 'summon',
    image: '/products/summonpot.webp',
    alt: 'Summonpot artwork showing a potion vessel with bounded capabilities and an agent',
    category: 'Contract-first agent-owned endpoints',
    statement: 'Declare the contract. Bound the authority.',
    choice: 'Expose typed endpoints that combine exact operations with bounded agent-owned decisions.',
    description:
      'Summonpot combines typed API contracts, deterministic application operations, and explicitly bounded agent-owned decisions behind one executable endpoint declaration.',
    href: 'https://github.com/tugrulguner/summonpot',
    accent: 'violet',
  },
];

const pageTitle = 'ModePot | Open-Source Python API, CLI, MCP & AI Tools';
const pageDescription =
  'ModePot is the open-source family behind Dexpot, Intpot, and Summonpot: Python frameworks for synchronous APIs, CLI/API/MCP tools, and bounded agent decisions.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://modepot.io/#website',
      url: 'https://modepot.io/',
      name: 'ModePot',
      description: pageDescription,
      inLanguage: 'en',
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://modepot.io/#webpage',
      url: 'https://modepot.io/',
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': 'https://modepot.io/#website' },
      mainEntity: { '@id': 'https://modepot.io/#projects' },
      inLanguage: 'en',
    },
    {
      '@type': 'ItemList',
      '@id': 'https://modepot.io/#projects',
      name: 'ModePot open-source Python projects',
      numberOfItems: 3,
      itemListElement: products.map((product, position) => ({
        '@type': 'ListItem',
        position: position + 1,
        item: {
          '@type': 'SoftwareSourceCode',
          name: product.name,
          description: product.description,
          codeRepository: product.href,
          programmingLanguage: 'Python',
          runtimePlatform: 'Python',
          license: 'https://opensource.org/license/mit',
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#070a12" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Tugrul Guner" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ModePot" />
    <meta property="og:url" content="https://modepot.io/" />
    <meta property="og:image" content="https://modepot.io/modepot-og.webp?v=2" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ModePot: three focused Python project modes held in one vessel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://modepot.io/modepot-og.webp?v=2" />
    <link rel="canonical" href="https://modepot.io/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="ModePot summary for AI agents" />
    <link rel="preload" href="/modepot-mark.svg" as="image" type="image/svg+xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#projects">Skip to the projects</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="ModePot home">
        <img src="/modepot-mark.svg" alt="" width="38" height="38" />
        <span>mode<strong>pot</strong></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/tugrulguner/modepot">GitHub</a>
        <a class="nav-signal" href="https://discord.gg/u3AANZr6RG">Discord</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="coordinate">MODE / 00 — THE SOURCE</p>
          <p class="hero-wordmark" aria-label="ModePot"><span>mode</span><strong>pot</strong></p>
          <h1 id="hero-title">Open-source Python frameworks for APIs, tools, and bounded agent decisions.</h1>
          <p class="hero-description">
            Dexpot owns execution. Intpot owns interfaces. Summonpot owns the boundary between
            deterministic application behavior and agent-owned decisions.
          </p>
          <a class="text-link" href="#projects">
            Compare the projects
            <span aria-hidden="true">↓</span>
          </a>
          <div class="hero-index" aria-label="ModePot projects">
            {
              products.map((product) => (
                <a href={`#${product.name}`}>
                  <span>{product.index}</span>
                  <b>{product.name}</b>
                  <small>{product.mode}</small>
                </a>
              ))
            }
          </div>
        </div>

        <div class="hero-object">
          <span class="orbit orbit-one"></span>
          <span class="orbit orbit-two"></span>
          <img src="/modepot-mark.svg" alt="ModePot mark with three project modes held in one vessel" width="420" height="420" fetchpriority="high" />
          <a class="mode-label label-execution" href="#dexpot"><i></i> dexpot / execution</a>
          <a class="mode-label label-interface" href="#intpot"><i></i> intpot / interface</a>
          <a class="mode-label label-decision" href="#summonpot"><i></i> summonpot / decision</a>
          <span class="object-note">THREE PROJECTS<br />THREE BOUNDARIES</span>
        </div>

        <p class="hero-aside" aria-hidden="true">PYTHON / OPEN SOURCE / MODEPOT</p>
      </section>

      <section class="family-intro" id="projects" aria-labelledby="family-title">
        <p class="coordinate">MODE / 01—03</p>
        <div>
          <h2 id="family-title">Choose the<br /><em>boundary.</em></h2>
          <p>
            ModePot is not one platform. It is three independent Python projects, each built around
            a narrow responsibility. Start with the problem you need to own.
          </p>
        </div>
      </section>

      <section class="mode-selector" aria-labelledby="selector-title">
        <h2 id="selector-title" class="visually-hidden">Which ModePot project should you use?</h2>
        <p class="selector-label">If you need to…</p>
        <p class="selector-label">Use</p>
        {
          products.map((product) => (
            <a class={`selector-row selector-${product.accent}`} href={`#${product.name}`}>
              <span>{product.choice}</span>
              <strong>{product.name}</strong>
              <i aria-hidden="true">↓</i>
            </a>
          ))
        }
      </section>

      <div class="product-ledger">
        {
          products.map((product) => (
            <article class={`product product-${product.accent}`} id={product.name}>
              <div class="product-index" aria-hidden="true">
                <span>{product.index}</span>
                <span>{product.mode}</span>
              </div>

              <figure class="product-art">
                <img src={product.image} alt={product.alt} loading="lazy" width="1200" height="900" />
                <figcaption>Mode {product.index} / {product.mode}</figcaption>
              </figure>

              <div class="product-copy">
                <h2><span>{product.prefix}</span><strong>pot</strong></h2>
                <p class="product-eyebrow">{product.category}</p>
                <p class="product-statement">{product.statement}</p>
                <p class="product-description">{product.description}</p>
                <div class="product-actions">
                  <a class="product-link" href={product.href}>
                    {product.name} on GitHub <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <section class="family-rule" id="about" aria-labelledby="about-title">
        <div class="rule-mark">
          <img src="/modepot-mark.svg" alt="" width="112" height="112" loading="lazy" />
        </div>
        <p class="coordinate">WHAT IS MODEPOT?</p>
        <h2 id="about-title">
          Three independent tools.<br />One <em>design instinct.</em>
        </h2>
        <div class="about-copy">
          <p>
            ModePot is an open-source family of Python frameworks created by Tugrul Guner. Each
            project owns one difficult boundary instead of growing into an everything-framework.
          </p>
          <p>
            Dexpot focuses on HTTP execution, Intpot on interface translation, and Summonpot on
            contract-first endpoints with explicitly bounded application authority.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="#top" aria-label="ModePot — back to top">
        <img src="/modepot-mark.svg" alt="" width="32" height="32" loading="lazy" />
        <span>mode<strong>pot</strong></span>
      </a>
      <p>Focused Python tools, built in public.</p>
      <div>
        <a href="https://github.com/tugrulguner/modepot">GitHub</a>
        <a href="https://discord.gg/u3AANZr6RG">Discord</a>
      </div>
    </footer>
  </body>
</html>
