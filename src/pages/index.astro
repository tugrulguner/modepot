---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

const products = [
  {
    index: '01',
    mode: 'execution',
    name: 'dexpot',
    prefix: 'dex',
    image: '/products/dexpot.webp',
    alt: 'Dexpot artwork showing a potion vessel with Python API code and execution symbols',
    category: 'Synchronous Python API framework',
    statement: 'Plain handlers. Adaptive execution.',
    choice: 'Build a synchronous Python HTTP API that adapts to GIL and free-threaded CPython.',
    description:
      'Dexpot compiles routes once, validates JSON with msgspec, and adapts concurrency to standard GIL or free-threaded Python—without asking application code to become async.',
    href: 'https://dexpot.modepot.io',
    action: 'Explore Dexpot',
    repository: 'https://github.com/tugrulguner/dexpot',
    programmingLanguage: 'Python',
    runtimePlatform: 'CPython',
    license: 'https://opensource.org/license/mit',
    accent: 'cyan',
  },
  {
    index: '02',
    mode: 'interface',
    name: 'intpot',
    prefix: 'int',
    image: '/products/intpot.webp',
    alt: 'Intpot artwork showing a potion vessel connecting code, API endpoints, and interfaces',
    category: 'One definition, three interfaces',
    statement: 'Define once. Serve in every direction.',
    choice: 'Serve typed Python tools as a CLI, HTTP API, or MCP server—or convert between them.',
    description:
      'Intpot turns typed Python tools into Typer CLIs, FastAPI apps, or FastMCP servers—and can inspect an existing app and convert it into either of the others.',
    href: 'https://github.com/tugrulguner/intpot',
    action: 'Intpot on GitHub',
    repository: 'https://github.com/tugrulguner/intpot',
    programmingLanguage: 'Python',
    runtimePlatform: 'Python',
    license: 'https://opensource.org/license/mit',
    accent: 'gold',
  },
  {
    index: '03',
    mode: 'decision',
    name: 'summonpot',
    prefix: 'summon',
    image: '/products/summonpot.webp',
    alt: 'Summonpot artwork showing a potion vessel with bounded capabilities and an agent',
    category: 'Contract-first agent-owned endpoints',
    statement: 'Declare the contract. Bound the authority.',
    choice: 'Expose typed endpoints that combine exact operations with bounded agent-owned decisions.',
    description:
      'Summonpot combines typed API contracts, deterministic application operations, and explicitly bounded agent-owned decisions behind one executable endpoint declaration.',
    href: 'https://github.com/tugrulguner/summonpot',
    action: 'Summonpot on GitHub',
    repository: 'https://github.com/tugrulguner/summonpot',
    programmingLanguage: 'Python',
    runtimePlatform: 'Python',
    license: 'https://opensource.org/license/mit',
    accent: 'violet',
  },
  {
    index: '04',
    mode: 'life',
    name: 'lifepot',
    prefix: 'life',
    image: '/products/lifepot.webp',
    alt: 'LifePot artwork showing a replayable artificial-life world inside a potion vessel',
    category: 'Bounded artificial-life game',
    statement: 'Describe a world. Watch deterministic life adapt.',
    choice: 'Create and replay a world where agent proposals become bounded simulation rules.',
    description:
      'LifePot is an open-source artificial-life game where Jev proposes typed ecology, deterministic code runs the world, and a validated ledger makes every accepted change inspectable and replayable.',
    href: 'https://github.com/tugrulguner/lifepot',
    action: 'LifePot on GitHub',
    repository: 'https://github.com/tugrulguner/lifepot',
    programmingLanguage: 'TypeScript',
    runtimePlatform: 'Web browser',
    license: 'https://opensource.org/license/mit',
    accent: 'mint',
  },
];

const pageTitle = 'ModePot | Modern Open-Source Frameworks, Engines & Games';
const pageDescription =
  'ModePot is an open-source community simplifying, modernizing, and performance-optimizing frameworks while building fast, simple, AI-native and agent-native tools, engines, and games.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://modepot.io/#website',
      url: 'https://modepot.io/',
      name: 'ModePot',
      description: pageDescription,
      inLanguage: 'en',
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://modepot.io/#webpage',
      url: 'https://modepot.io/',
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': 'https://modepot.io/#website' },
      mainEntity: { '@id': 'https://modepot.io/#projects' },
      inLanguage: 'en',
    },
    {
      '@type': 'ItemList',
      '@id': 'https://modepot.io/#projects',
      name: 'ModePot open-source projects',
      numberOfItems: products.length,
      itemListElement: products.map((product, position) => ({
        '@type': 'ListItem',
        position: position + 1,
        item: {
          '@type': 'SoftwareSourceCode',
          name: product.name,
          description: product.description,
          url: product.href,
          codeRepository: product.repository,
          programmingLanguage: product.programmingLanguage,
          runtimePlatform: product.runtimePlatform,
          license: product.license,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#070a12" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Tugrul Guner" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ModePot" />
    <meta property="og:url" content="https://modepot.io/" />
    <meta property="og:image" content="https://modepot.io/modepot-og.webp?v=5" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ModePot: modern open-source frameworks, engines, and games" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://modepot.io/modepot-og.webp?v=5" />
    <link rel="canonical" href="https://modepot.io/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="ModePot summary for AI agents" />
    <link rel="preload" href="/modepot-mark.svg?v=5" as="image" type="image/svg+xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#projects">Skip to the projects</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="ModePot home">
        <img src="/modepot-mark.svg?v=5" alt="" width="38" height="38" />
        <span>mode<strong>pot</strong></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/tugrulguner/modepot">GitHub</a>
        <a class="nav-signal" href="https://discord.gg/u3AANZr6RG">Discord</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="coordinate">OPEN SOURCE / BUILT FOR THE NEXT ERA</p>
          <p class="hero-wordmark" aria-label="ModePot"><span>mode</span><strong>pot</strong></p>
          <h1 id="hero-title">We simplify, modernize, and performance-optimize the software people build on.</h1>
          <p class="hero-description">
            ModePot is an open-source family and community creating fast, simple, AI-native and
            agent-native frameworks, tools, engines, and games. Dexpot, Intpot, Summonpot, and
            LifePot are the start. More frameworks, games, and engines will follow.
          </p>
          <a class="text-link" href="#projects">
            Compare the projects
            <span aria-hidden="true">↓</span>
          </a>
          <div class="hero-index" aria-label="ModePot projects">
            {
              products.map((product) => (
                <a href={`#${product.name}`}>
                  <span>{product.index}</span>
                  <b>{product.name}</b>
                  <small>{product.mode}</small>
                </a>
              ))
            }
          </div>
        </div>

        <div class="hero-object">
          <span class="orbit orbit-one"></span>
          <span class="orbit orbit-two"></span>
          <img src="/modepot-mark.svg?v=5" alt="ModePot mark: modern software ingredients pouring into an open M-shaped flask" width="420" height="420" fetchpriority="high" />
          <span class="mode-label label-simple"><i></i> simplicity</span>
          <span class="mode-label label-modern"><i></i> modern foundations</span>
          <span class="mode-label label-performance"><i></i> performance</span>
          <span class="mode-label label-ai"><i></i> ai-native</span>
          <span class="mode-label label-agents"><i></i> agent-native</span>
          <span class="object-note">A GROWING<br />OPEN-SOURCE FAMILY</span>
        </div>

        <p class="hero-aside" aria-hidden="true">FRAMEWORKS / ENGINES / GAMES / MODEPOT</p>
      </section>

      <section class="family-intro" id="projects" aria-labelledby="family-title">
        <p class="coordinate">THE FAMILY / CURRENT PROJECTS</p>
        <div>
          <h2 id="family-title">Building the<br /><em>new defaults.</em></h2>
          <p>
            We take frameworks and software foundations that have become heavy, fragmented, or
            dated and rebuild them around simple interfaces, modern runtimes, real performance,
            and first-class support for AI and agents. Everything is open source and community-built.
          </p>
        </div>
      </section>

      <section class="mode-selector" aria-labelledby="selector-title">
        <h2 id="selector-title" class="visually-hidden">Which ModePot project should you use?</h2>
        <p class="selector-label">If you need to…</p>
        <p class="selector-label">Use</p>
        {
          products.map((product) => (
            <a class={`selector-row selector-${product.accent}`} href={`#${product.name}`}>
              <span>{product.choice}</span>
              <strong>{product.name}</strong>
              <i aria-hidden="true">↓</i>
            </a>
          ))
        }
      </section>

      <div class="product-ledger">
        {
          products.map((product) => (
            <article class={`product product-${product.accent}`} id={product.name}>
              <div class="product-index" aria-hidden="true">
                <span>{product.index}</span>
                <span>{product.mode}</span>
              </div>

              <figure class="product-art">
                <img src={product.image} alt={product.alt} loading="lazy" width="1200" height="900" />
                <figcaption>Mode {product.index} / {product.mode}</figcaption>
              </figure>

              <div class="product-copy">
                <h2><span>{product.prefix}</span><strong>pot</strong></h2>
                <p class="product-eyebrow">{product.category}</p>
                <p class="product-statement">{product.statement}</p>
                <p class="product-description">{product.description}</p>
                <div class="product-actions">
                  <a class="product-link" href={product.href}>
                    {product.action} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <section class="family-rule" id="about" aria-labelledby="about-title">
        <div class="rule-mark">
          <img src="/modepot-mark.svg?v=5" alt="" width="112" height="112" loading="lazy" />
        </div>
        <p class="coordinate">WHAT IS MODEPOT?</p>
        <h2 id="about-title">
          Simpler software.<br /><em>Bigger possibilities.</em>
        </h2>
        <div class="about-copy">
          <p>
            ModePot exists to remove accumulated complexity. We simplify how frameworks are used,
            modernize how they are built, and optimize the paths that matter without passing the
            machinery on to developers.
          </p>
          <p>
            We are building an open-source family of fast, approachable, AI-native and agent-native
            frameworks, tools, engines, and games. Dexpot, Intpot, Summonpot, and LifePot are only
            the beginning.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="#top" aria-label="ModePot — back to top">
        <img src="/modepot-mark.svg?v=5" alt="" width="32" height="32" loading="lazy" />
        <span>mode<strong>pot</strong></span>
      </a>
      <p>Open source. Built with the community.</p>
      <div>
        <a href="https://github.com/tugrulguner/modepot">GitHub</a>
        <a href="https://discord.gg/u3AANZr6RG">Discord</a>
      </div>
    </footer>
  </body>
</html>
