---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import projectSources from '../data/projects.json';
const sourceByName = new Map(projectSources.map((project) => [project.name, project]));

const lifeSeed = [
  '00000000',
  '00100000',
  '00010000',
  '01110000',
  '00000000',
  '00000000',
  '00000000',
  '00000000',
];
const lifeGenerations = [lifeSeed];
for (let generation = 1; generation < 4; generation += 1) {
  const previous = lifeGenerations[generation - 1];
  lifeGenerations.push(previous.map((row, y) =>
    [...row].map((cell, x) => {
      let neighbors = 0;
      for (let dy = -1; dy <= 1; dy += 1) for (let dx = -1; dx <= 1; dx += 1) {
        if (!dx && !dy) continue;
        neighbors += previous[(y + dy + 8) % 8][(x + dx + 8) % 8] === '1' ? 1 : 0;
      }
      return neighbors === 3 || (cell === '1' && neighbors === 2) ? '1' : '0';
    }).join(''),
  ));
}
const productDefinitions = [
  {
    index: '01',
    mode: 'execution',
    name: 'dexpot',
    prefix: 'dex',
    mark: '/marks/dexpot-mark.svg',
    image: '/products/dexpot-lockup.webp',
    alt: 'Minimal Dexpot lockup using its ModePot family mark',
    category: 'Synchronous Python API framework',
    statement: 'Plain handlers. Adaptive execution.',
    choice: 'Build a synchronous Python HTTP API that adapts to GIL and free-threaded CPython.',
    description:
      'Dexpot compiles routes once, validates JSON with msgspec, and adapts concurrency to standard GIL or free-threaded Python—without asking application code to become async.',
    href: 'https://dexpot.modepot.io/',
    action: 'Explore Dexpot',
    repository: 'https://github.com/tugrulguner/dexpot',
    docs: 'https://dexpot.modepot.io/quick-start/',
    development: '',
    developmentLabel: '',
    programmingLanguage: 'Python',
    runtimePlatform: 'CPython',
    license: 'https://opensource.org/license/mit',
    accent: 'cyan',
    signal: 'request → response',
    playground: 'https://dexpot.modepot.io/playground/',
    demoDescription: 'Request, typed validation, and response.',
  },
  {
    index: '02',
    mode: 'interface',
    name: 'intpot',
    prefix: 'int',
    mark: '/marks/intpot-mark.svg',
    image: '/products/intpot-lockup.webp',
    alt: 'Minimal Intpot lockup using its ModePot family mark',
    category: 'One definition, three interfaces',
    statement: 'Define once. Serve in every direction.',
    choice: 'Serve typed Python tools as a CLI, HTTP API, or MCP server—or convert between them.',
    description:
      'Intpot turns typed Python tools into Typer CLIs, FastAPI apps, or FastMCP servers—and can inspect an existing app and convert it into either of the others.',
    href: 'https://intpot.modepot.io/',
    action: 'Explore Intpot',
    repository: 'https://github.com/tugrulguner/intpot',
    docs: 'https://intpot.modepot.io/quickstart/',
    development: '',
    developmentLabel: '',
    programmingLanguage: 'Python',
    runtimePlatform: 'Python',
    license: 'https://opensource.org/license/mit',
    accent: 'gold',
    signal: 'define → serve',
    playground: 'https://intpot.modepot.io/playground/',
    demoDescription: 'One typed function branches into CLI, HTTP, and MCP interfaces.',
  },
  {
    index: '03',
    mode: 'decision',
    name: 'summonpot',
    prefix: 'summon',
    mark: '/marks/summonpot-mark.svg',
    image: '/products/summonpot-lockup.webp',
    alt: 'Minimal Summonpot lockup using its ModePot family mark',
    category: 'Contract-first agent-owned endpoints',
    statement: 'Declare the contract. Bound the authority.',
    choice: 'Expose typed endpoints that combine exact operations with bounded agent-owned decisions.',
    description:
      'Summonpot combines typed API contracts, deterministic application operations, and explicitly bounded agent-owned decisions behind one executable endpoint declaration.',
    href: 'https://summonpot.modepot.io/',
    action: 'Explore Summonpot',
    repository: 'https://github.com/tugrulguner/summonpot',
    docs: 'https://summonpot.modepot.io/quick-start/',
    development: '',
    developmentLabel: '',
    programmingLanguage: 'Python',
    runtimePlatform: 'Python',
    license: 'https://opensource.org/license/mit',
    accent: 'violet',
    signal: 'contract → decide',
    playground: 'https://summonpot.modepot.io/playground/',
    demoDescription: 'Fixed request-owned values, bounded agent choice, application result.',
  },
  {
    index: '04',
    mode: 'life',
    name: 'lifepot',
    prefix: 'life',
    mark: '/marks/lifepot-mark.svg',
    image: '/products/lifepot-lockup.webp',
    alt: 'Minimal LifePot lockup using its ModePot family mark',
    category: 'Bounded artificial-life game',
    statement: 'Describe a world. Watch deterministic life adapt.',
    choice: 'Create and replay a world where agent proposals become bounded simulation rules.',
    description:
      'LifePot is an open-source artificial-life game where Jev proposes typed ecology, deterministic code runs the world, and a validated ledger makes every accepted change inspectable and replayable.',
    href: 'https://lifepot.modepot.io/',
    action: 'Explore LifePot',
    repository: 'https://github.com/tugrulguner/lifepot',
    docs: 'https://github.com/tugrulguner/lifepot/blob/main/docs/simulation-contract.md',
    development: '',
    developmentLabel: '',
    programmingLanguage: 'TypeScript',
    runtimePlatform: 'Web browser',
    license: 'https://opensource.org/license/mit',
    accent: 'mint',
    signal: 'propose → replay',
    playground: 'https://lifepot.modepot.io/',
    demoDescription: 'Cells evolve across generations in an illustrative animation.',
  },
];
const products = productDefinitions.map((product) => ({ ...product, source: sourceByName.get(product.name)! }));

const pageTitle = 'ModePot | Modern Open-Source Frameworks, Engines & Games';
const pageDescription =
  'ModePot is an open-source family simplifying, modernizing, and performance-optimizing frameworks, tools, engines, and games for the AI era.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://modepot.io/#website',
      url: 'https://modepot.io/',
      name: 'ModePot',
      description: pageDescription,
      inLanguage: 'en',
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://modepot.io/#webpage',
      url: 'https://modepot.io/',
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': 'https://modepot.io/#website' },
      mainEntity: { '@id': 'https://modepot.io/#projects' },
      inLanguage: 'en',
    },
    {
      '@type': 'ItemList',
      '@id': 'https://modepot.io/#projects',
      name: 'ModePot open-source projects',
      numberOfItems: products.length,
      itemListElement: products.map((product, position) => ({
        '@type': 'ListItem',
        position: position + 1,
        item: {
          '@type': 'SoftwareSourceCode',
          name: product.name,
          description: product.description,
          url: product.href,
          codeRepository: product.repository,
          programmingLanguage: product.programmingLanguage,
          runtimePlatform: product.runtimePlatform,
          license: product.license,
        },
      })),
    },
  ],
};
