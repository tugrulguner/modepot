    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#projects">Skip to the projects</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="ModePot home">
        <img src="/modepot-mark.svg?v=6" alt="" width="38" height="38" />
        <span>mode<strong>pot</strong></span>
      </a>
      <nav aria-label="Primary navigation">
      <a class="ph-no-autocapture" href="#projects">Projects</a>
        <a class="ph-no-autocapture" href="#about">About</a>
        <a class="ph-no-autocapture" href="https://tugrul.modepot.io/">About me</a>
        <a class="ph-no-autocapture" href="https://github.com/tugrulguner/modepot">GitHub</a>
        <a class="nav-signal ph-no-autocapture" href="https://discord.gg/u3AANZr6RG">Discord</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="coordinate">OPEN SOURCE / BUILT FOR THE NEXT ERA</p>
